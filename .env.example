# Server-only PostgreSQL connection string used by Prisma.
# On Railway, set this as a reference to the Postgres service's private
# DATABASE_URL. Do not use DATABASE_PUBLIC_URL or expose it through VITE_*.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Railway injects PORT automatically; do not set it in Railway Variables.
# Local development defaults to 3000.
PORT=3000
NODE_ENV=development

# Optional public order-reference prefix (2-10 uppercase letters/numbers).
ORDER_REFERENCE_PREFIX=ASILI

# Required in production if /api/contact should deliver email.
RESEND_API_KEY=

# Optional contact-delivery overrides. Defaults preserve the current Asili setup.
CONTACT_FROM_EMAIL="Asili Web <onboarding@resend.dev>"
CONTACT_TO_EMAIL="kevinsila100@gmail.com"

# Owner dashboard authentication. All values are server-only.
# Generate ADMIN_PASSWORD_HASH locally with: npm run admin:hash-password
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# Use at least 32 random characters. Rotating this signs out existing sessions.
ADMIN_SESSION_SECRET=
# Optional; defaults to 8 and is capped at 24 hours.
ADMIN_SESSION_HOURS=8

# Owner notification for newly created website orders. Falls back to
# CONTACT_TO_EMAIL when ORDER_NOTIFICATION_TO_EMAIL is empty.
ORDER_NOTIFICATION_TO_EMAIL=
# Public Netlify admin URL used in notification links.
ADMIN_PUBLIC_URL="https://asilii.netlify.app/admin/"
