# PostgreSQL connection string used only by Prisma on the server.
# Never expose this value through a VITE_* variable.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Railway injects PORT automatically. Local development defaults to 3000.
PORT=3000
NODE_ENV=development

# RESEND_API_KEY: Required for sending emails via Resend.
RESEND_API_KEY=

# Optional contact-delivery overrides. Defaults preserve the current Asili setup.
CONTACT_FROM_EMAIL="Asili Web <onboarding@resend.dev>"
CONTACT_TO_EMAIL="kevinsila100@gmail.com"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
